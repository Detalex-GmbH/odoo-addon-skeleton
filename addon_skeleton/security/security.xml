<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bereich in Einstellungen › Benutzer, unter dem die Gruppen erscheinen -->
    <record id="privilege_addon_skeleton" model="res.groups.privilege">
        <field name="name">Addon Skeleton</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_skeleton_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_addon_skeleton"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_skeleton_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_addon_skeleton"/>
        <field name="implied_ids" eval="[(4, ref('group_skeleton_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
