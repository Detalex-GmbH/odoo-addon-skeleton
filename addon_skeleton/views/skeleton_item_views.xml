<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="skeleton_item_view_list" model="ir.ui.view">
        <field name="name">skeleton.item.list</field>
        <field name="model">skeleton.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="skeleton_item_view_form" model="ir.ui.view">
        <field name="name">skeleton.item.form</field>
        <field name="model">skeleton.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_skeleton_code"><field name="code"/></div>
                        <h1><field name="name" placeholder="Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="skeleton_item_view_search" model="ir.ui.view">
        <field name="name">skeleton.item.search</field>
        <field name="model">skeleton.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <filter name="my" string="My Items" domain="[('user_id', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="skeleton_item_action" model="ir.actions.act_window">
        <field name="name">Skeleton Items</field>
        <field name="res_model">skeleton.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first item</p>
        </field>
    </record>
</odoo>
